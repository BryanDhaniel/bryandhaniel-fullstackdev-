# Dependencies
node_modules/

# Build output
dist/
build/

# Environment — never commit real secrets
.env
.env.local
.env.*.local

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Database dumps / backups — may contain personal data, never commit
.backup/
*.dump
*.sql.gz

# --- Catatan lokal, tidak untuk di-upload ke GitHub -------------------------
# Folder kerja asisten (memori sesi, skill, konfigurasi lokal)
.workbuddy-ai/

# Panduan start lokal untuk mesin ini — berisi path absolut & nama service
# spesifik mesin, tidak relevan untuk reviewer atau kontributor lain
START-HERE.md

# Catatan migrasi & backup lokal yang menyertai START-HERE.md
*.local.md

# --- Berkas review lokal (scratch) ------------------------------------------
# Folder kerja untuk screenshot & skrip verifikasi UI. Isinya: skrip puppeteer
# (.cjs), hasil screenshot (.png), dan salinan node_modules (~45 MB).
# Tidak ada satu pun yang perlu di-push.
#
# Catatan: .cjs sengaja TIDAK di-ignore per-ekstensi. Banyak tool memakai .cjs
# untuk file konfigurasi yang justru harus di-commit. Yang di-ignore folder-nya.
.review/

# --- Binari gambar & media ---------------------------------------------------
# Repo ini tidak menyimpan aset gambar sama sekali: ikon memakai
# @phosphor-icons/react, favicon berupa inline SVG data-URI. Jadi gambar yang
# muncul di sini hampir pasti hasil screenshot / template desain, bukan aset app.
#
# .svg SENGAJA dikecualikan dari daftar ini karena SVG adalah format aset yang
# sah untuk ikon/logo dan biasanya memang perlu di-commit.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tif
*.tiff

# Rekaman layar & ekspor desain (kalau nanti ada)
*.mp4
*.mov
*.webm

# Arsip — hindari binari besar masuk ke riwayat Git
*.zip
*.tar
*.tar.gz
*.7z
