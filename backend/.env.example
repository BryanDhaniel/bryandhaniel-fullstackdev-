# ---------------------------------------------------------------------------
# IndoKerja.id — Backend environment
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Origin allowed to make credentialed (cookie-bearing) cross-origin requests.
# Must be an explicit origin — never '*' — because the refresh token is sent
# as an httpOnly cookie. See docs/adr/0004.
CORS_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml. If you are running PostgreSQL natively, the only
# part that usually changes is the password.
DATABASE_URL="postgresql://indokerja:indokerja@localhost:5432/indokerja?schema=public"

# --- Authentication --------------------------------------------------------
# CHANGE THIS IN ANY NON-LOCAL ENVIRONMENT. The app refuses to start in
# production if this is left at the placeholder value.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m

# Refresh tokens are opaque random strings stored as bcrypt hashes, not JWTs,
# so no refresh signing secret is required. See docs/adr/0004.
JWT_REFRESH_EXPIRES_IN_DAYS=7

# bcrypt cost factor for both passwords and refresh-token hashes.
BCRYPT_ROUNDS=10

# --- Seed data -------------------------------------------------------------
# Password assigned to every seeded demo account (seeker@demo.com, etc.)
SEED_PASSWORD=Password123!
